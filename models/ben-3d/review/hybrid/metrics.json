      "reason": "The sculpted face is 6 units wide, narrower than the helmet and shoulders, where the sprite face band is about 8 pixels; the model is intentionally up to four pixels narrower."
    },
    "torsoWidth": {
      "min": -4,
      "max": 2,
      "reason": "Ben is built as a skinny kid: a narrow 4.9-unit ribcage and shoulders set 3.4 units from the centre, so the shirt-and-arms band is intentionally up to four pixels narrower than the sprite, most at the quarter views."
    },
    "shoeWidth": {
      "min": -5,
      "max": 2,
      "reason": "Running shoes are 6.8 units long and 2.5 wide (about 22% of height) on slim legs set 1.45 from the centre, instead of the sprite-sized 8.7 by 3.6 (28%); combined shoe widths are intentionally up to five pixels narrower, most in profile."
    },
    "shoeHeight": {
      "min": -3,
      "max": 2,
      "reason": "The shorter shoe has a proportionally lower 2.6-unit ankle collar than the sprite toe-cap rows."
    }
  },
