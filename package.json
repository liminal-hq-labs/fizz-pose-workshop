{
  "name": "classic-fizz-pose-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "generate": "bun scripts/build-assets.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run generate && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/bun": "1.4.4",
    "@types/pngjs": "6.0.5"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "pngjs": "7.0.0"
  }
}
