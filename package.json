{
  "name": "classic-fizz-pose-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run typecheck && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "generate": "bun scripts/build-assets.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run generate && bun run typecheck && bun run test && bun run build",
    "draw:run": "bun scripts/draw-run-cycle.ts",
    "rig:export": "bun scripts/export-rig.ts",
    "draw:actions": "bun scripts/draw-action-rigs.ts",
    "draw:performances": "bun scripts/draw-performance-rigs.ts",
    "draw:look-loop": "bun scripts/draw-look-loop.ts",
    "draw:turntable": "bun scripts/draw-turntable.ts",
    "draw:stunner": "bun scripts/draw-stunner-study.ts",
    "model:build": "bun scripts/build-ben-3d.ts",
    "model:review": "bun scripts/review-ben-3d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "1.4.4",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.187.0",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "three": "0.187.0"
  }
}
